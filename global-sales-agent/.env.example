# ───────────── App ─────────────
APP_URL=http://localhost:3000
NODE_ENV=development
# デモモード：外部AIキー/外部プラットフォーム不要で完全動作
DEMO_MODE=true

# ───────────── Database ─────────────
DATABASE_URL=postgresql://gsa:gsa@localhost:5432/global_sales_agent?schema=public

# ───────────── Redis / Queue（未設定時は in-process インライン実行）─────────────
REDIS_URL=
# REDIS_URL=redis://localhost:6379

# ───────────── Auth (Auth.js) ─────────────
# openssl rand -base64 32
AUTH_SECRET=change-me-please-use-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# ───────────── Encryption（プラットフォーム認証情報の暗号化）─────────────
# openssl rand -base64 32  (32 bytes)
ENCRYPTION_KEY=

# ───────────── AI Providers ─────────────
# どちらか設定すると実AIが有効。未設定 or DEMO_MODE=true の場合は Mock Provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=auto            # auto | anthropic | openai | mock
AI_DEFAULT_MODEL=           # 例: claude-sonnet-4-5 / gpt-4.1

# ───────────── Platform Connectors（任意）─────────────
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
FREELANCER_OAUTH_TOKEN=
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret

# ───────────── Serverless cron (Vercel Cron → GET /api/cron/tick) ─────────────
CRON_SECRET=

# ───────────── Worker ─────────────
DISCOVERY_INTERVAL_MINUTES=30
REPLY_POLL_INTERVAL_MINUTES=5

# ───────────── Seed（デモ）─────────────
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=Demo1234!
